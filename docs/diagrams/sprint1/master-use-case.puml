@startuml
!pragma layout smetana
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #5B4636
skinparam roundcorner 12
skinparam packageStyle rectangle
skinparam noteBackgroundColor #FFF6DA
skinparam noteBorderColor #B89551
skinparam actorBorderColor #5B4636
skinparam actorFontColor #382A23
skinparam rectangleBorderColor #80644F
skinparam usecaseBorderColor #80644F
skinparam entityBorderColor #80644F
skinparam activityBorderColor #80644F
skinparam activityBackgroundColor #F9F2E9
skinparam activityDiamondBackgroundColor #FFF6DA
skinparam activityDiamondBorderColor #80644F
skinparam swimlaneBorderColor #C9B9A9
left to right direction
title BrewLite — Master Use Case\nPhân kỳ theo hồ sơ Sprint 1 v1.1; làm rõ đặt đơn và thanh toán
skinparam usecaseBackgroundColor #FFFFFF
skinparam nodesep 35
skinparam ranksep 55

actor "Khách hàng" as Customer
actor "Cổng thanh toán giả lập\n[Sprint 3]" as Gateway

rectangle "Hệ thống BrewLite" {
  package "Sprint 1 — Menu và giá xem trước" as S1 #EAF4EB {
    usecase "UC-01: Xem menu" as UC01
    usecase "UC-02: Xem chi tiết sản phẩm" as UC02
    usecase "UC-03: Chọn size và topping" as UC03
    usecase "UC-04: Tính và hiển thị giá" as UC04
  }
  package "Sprint 2 — Giỏ hàng, tài khoản, tạo đơn" as S2 #FFF3D6 {
    usecase "UC-05: Quản lý giỏ hàng" as UC05
    usecase "UC-06: Đăng ký tài khoản" as UC06
    usecase "UC-07: Đăng nhập" as UC07
    usecase "UC-08: Đặt hàng" as UC08
  }
  package "Sprint 3 — Thanh toán và nghiệp vụ tiếp theo" as S3 #E8EEF9 {
    usecase "UC-09: Thanh toán không tiền mặt" as UC09
    usecase "UC-10: Xem xác nhận đơn" as UC10
    usecase "UC-11: Xem lịch sử và trạng thái đơn" as UC11
    usecase "UC-12: Áp mã giảm giá" as UC12
    usecase "UC-13: Tích lũy điểm thưởng" as UC13
  }
}

Customer -- UC01
Customer -- UC02
Customer -- UC03
Customer -- UC05
Customer -- UC06
Customer -- UC07
Customer -- UC08
Customer -- UC09
Customer -- UC10
Customer -- UC11
Customer -- UC12

UC03 ..> UC04 : <<include>>
UC10 ..> UC09 : <<extend>>\n[khi khách xem xác nhận sau thanh toán]
UC12 ..> UC08 : <<extend>>\n[khi áp dụng mã giảm giá]
UC13 ..> UC09 : <<extend>>\n[thanh toán thành công, đủ điều kiện]
UC09 -right- Gateway
S1 -[hidden]down-> S2
S2 -[hidden]down-> S3

legend bottom
  Sprint 2: POST /orders tạo đơn PENDING, không bắt buộc thực hiện UC-09.
  Sprint 3: Thanh toán đơn đã tạo; xác nhận / lịch sử và các nghiệp vụ tiếp theo.
  Quan hệ extend mô tả hành vi mở rộng có điều kiện, không phải thứ tự thực thi.
  Luồng mở rộng Sprint 3 được làm rõ khi lập kế hoạch Sprint 3.
endlegend

@enduml
