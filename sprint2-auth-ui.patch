@@ -0,0 +1,38 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { AuthApiError, isOutcomeUnknown, messageForAuthError } from "./auth-error.ts";
+
+const err = (code, status = 0) => new AuthApiError(code, "", status);
+
+test("đăng nhập sai không bị hiểu là hết hạn phiên", () => {
+  const msg = messageForAuthError(err("INVALID_CREDENTIALS", 401), "login");
+  assert.match(msg, /không đúng/);
+  assert.doesNotMatch(msg, /hết hạn/);
+});
+
+test("email trùng và hết hạn có thông báo riêng", () => {
+  assert.match(messageForAuthError(err("EMAIL_ALREADY_EXISTS", 409), "register"), /đã được sử dụng/);
+  assert.match(messageForAuthError(err("SESSION_EXPIRED", 401), "me"), /hết hạn/);
+});
+
+test("REQUEST_FORBIDDEN không bị coi là hết hạn", () => {
+  assert.doesNotMatch(messageForAuthError(err("REQUEST_FORBIDDEN", 403), "login"), /hết hạn/);
+});
+
+test("lỗi mạng khi đăng xuất không khẳng định đã đăng xuất", () => {
+  for (const code of ["NETWORK_ERROR", "CLIENT_TIMEOUT", "UPSTREAM_TIMEOUT", "UPSTREAM_UNAVAILABLE", "INTERNAL_ERROR"]) {
+    const msg = messageForAuthError(err(code), "logout");
+    assert.match(msg, /Chưa xác nhận/);
+    assert.doesNotMatch(msg, /Đã đăng xuất/);
+  }
+});
+
+test("lỗi hệ thống khi đăng ký không khẳng định chưa tạo tài khoản", () => {
+  assert.match(messageForAuthError(err("CLIENT_TIMEOUT"), "register"), /có thể đã được tạo/);
+});
+
+test("isOutcomeUnknown", () => {
+  assert.equal(isOutcomeUnknown(err("NETWORK_ERROR")), true);
+  assert.equal(isOutcomeUnknown(err("UNKNOWN", 503)), true);
+  assert.equal(isOutcomeUnknown(err("INVALID_CREDENTIALS", 401)), false);
+});
diff --git a/frontend/src/features/auth/auth-error.ts b/frontend/src/features/auth/auth-error.ts
new file mode 100644
index 0000000..d064928
--- /dev/null
+++ b/frontend/src/features/auth/auth-error.ts
@@ -0,0 +1,69 @@
+import type { AuthAction, AuthErrorCode, FieldErrors } from "./types.ts";
+
+export class AuthApiError extends Error {
+  readonly code: AuthErrorCode;
+  readonly status: number;
+  readonly fieldErrors: FieldErrors;
+
+  constructor(code: AuthErrorCode, message: string, status = 0, fieldErrors: FieldErrors = {}) {
+    super(message);
+    this.name = "AuthApiError";
+    this.code = code;
+    this.status = status;
+    this.fieldErrors = fieldErrors;
+  }
+}
+
+/** Lỗi mà trình duyệt không thể kết luận server đã xử lý hay chưa. */
+export function isOutcomeUnknown(error: AuthApiError): boolean {
+  return (
+    error.code === "NETWORK_ERROR" ||
+    error.code === "CLIENT_TIMEOUT" ||
+    error.code === "UPSTREAM_TIMEOUT" ||
+    error.code === "UPSTREAM_UNAVAILABLE" ||
+    error.code === "INTERNAL_ERROR" ||
+    error.status >= 500
+  );
+}
+
+/**
+ * Thông báo hiển thị cho người dùng, theo bảng phản ứng của v0.6.
+ * Không bao giờ nói đã đăng xuất hoặc đã thu hồi phiên khi gặp lỗi hệ thống.
+ */
+export function messageForAuthError(error: AuthApiError, action: AuthAction): string {
+  switch (error.code) {
+    case "INVALID_CREDENTIALS":
+      return "Email hoặc mật khẩu không đúng.";
+    case "EMAIL_ALREADY_EXISTS":
+      return "Email này đã được sử dụng.";
+    case "VALIDATION_ERROR":
+      return "Vui lòng kiểm tra thông tin đã nhập.";
+    case "REQUEST_FORBIDDEN":
+      return "Yêu cầu bị từ chối. Vui lòng tải lại trang rồi thử lại.";
+    case "PAYLOAD_TOO_LARGE":
+      return "Dữ liệu gửi đi quá lớn. Vui lòng rút ngắn rồi thử lại.";
+    case "AUTH_REQUIRED":
+    case "SESSION_INVALID":
+      return "Vui lòng đăng nhập để tiếp tục.";
+    case "SESSION_EXPIRED":
+      return "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.";
+    default:
+      break;
+  }
+
+  if (!isOutcomeUnknown(error)) {
+    return "Có lỗi xảy ra. Vui lòng thử lại.";
+  }
+
+  switch (action) {
+    case "register":
+      // Chưa rõ kết quả: không khẳng định tài khoản chắc chắn chưa được tạo.
+      return "Chưa nhận được kết quả đăng ký. Tài khoản có thể đã được tạo; bạn có thể thử đăng nhập hoặc đăng ký lại.";
+    case "logout":
+      return "Chưa xác nhận đăng xuất hoàn tất. Phiên và giỏ hàng vẫn được giữ; vui lòng thử lại.";
+    case "login":
+      return "Không thể đăng nhập lúc này. Giỏ hàng của bạn vẫn được giữ; vui lòng thử lại.";
+    case "me":
+      return "Không kiểm tra được phiên đăng nhập lúc này.";
+  }
+}
diff --git a/frontend/src/features/auth/auth-provider.tsx b/frontend/src/features/auth/auth-provider.tsx
new file mode 100644
index 0000000..b8ef707
--- /dev/null
+++ b/frontend/src/features/auth/auth-provider.tsx
@@ -0,0 +1,113 @@
+"use client";
+
+import {
+  createContext,
+  useCallback,
+  useContext,
+  useEffect,
+  useMemo,
+  useRef,
+  useState,
+  type ReactNode,
+} from "react";
+import { createAuthClient, type AuthClient, type Credentials } from "./auth-client";
+import { AuthApiError } from "./auth-error";
+import type { AuthUser, LogoutScope } from "./types";
+
+/**
+ * loading: đang hỏi /api/auth/me.
+ * anonymous: chắc chắn chưa đăng nhập (AUTH_REQUIRED/SESSION_INVALID/SESSION_EXPIRED).
+ * unknown: không kiểm tra được (mạng, 5xx); KHÔNG suy ra là hết hạn.
+ */
+export type AuthStatus = "loading" | "authenticated" | "anonymous" | "unknown";
+
+type SignOutHandler = (scope: LogoutScope) => void;
+
+export type AuthContextValue = {
+  status: AuthStatus;
+  user: AuthUser | null;
+  /** Hết hạn phiên đã được phát hiện ở lần kiểm tra gần nhất. */
+  sessionExpired: boolean;
+  login: (input: Credentials) => Promise<void>;
+  register: (input: Credentials) => Promise<void>;
+  /** Ném AuthApiError nếu chưa xác nhận đăng xuất; khi đó trạng thái đăng nhập được giữ nguyên. */
+  logout: () => Promise<LogoutScope>;
+  refresh: () => Promise<void>;
+  /** Cho module khác (giỏ hàng, đơn) dọn dữ liệu riêng tư sau đăng xuất thành công. Trả hàm hủy đăng ký. */
+  onSignedOut: (handler: SignOutHandler) => () => void;
+};
+
+const AuthContext = createContext<AuthContextValue | null>(null);
+
+export function AuthProvider({ children, client }: { children: ReactNode; client?: AuthClient }) {
+  const clientRef = useRef<AuthClient>(client ?? createAuthClient());
+  const handlers = useRef(new Set<SignOutHandler>());
+  const [status, setStatus] = useState<AuthStatus>("loading");
+  const [user, setUser] = useState<AuthUser | null>(null);
+  const [sessionExpired, setSessionExpired] = useState(false);
+
+  const refresh = useCallback(async () => {
+    try {
+      const session = await clientRef.current.me();
+      setUser(session.user);
+      setStatus("authenticated");
+      setSessionExpired(false);
+    } catch (error) {
+      const code = error instanceof AuthApiError ? error.code : "UNKNOWN";
+      if (code === "AUTH_REQUIRED" || code === "SESSION_INVALID" || code === "SESSION_EXPIRED") {
+        setUser(null);
+        setStatus("anonymous");
+        setSessionExpired(code === "SESSION_EXPIRED");
+      } else {
+        // Lỗi hệ thống: giữ người dùng hiện tại nếu có, không giả định hết hạn.
+        setStatus((current) => (current === "authenticated" ? current : "unknown"));
+      }
+    }
+  }, []);
+
+  useEffect(() => {
+    // Kiểm tra phiên một lần khi tải trang; setState chạy sau await nên không đồng bộ trong effect.
+    void refresh();
+  }, [refresh]);
+
+  const login = useCallback(async (input: Credentials) => {
+    const session = await clientRef.current.login(input);
+    setUser(session.user);
+    setStatus("authenticated");
+    setSessionExpired(false);
+  }, []);
+
+  const register = useCallback(async (input: Credentials) => {
+    // Đăng ký không cấp phiên (v0.6); người dùng phải đăng nhập sau đó.
+    await clientRef.current.register(input);
+  }, []);
+
+  const logout = useCallback(async () => {
+    const scope = await clientRef.current.logout();
+    setUser(null);
+    setStatus("anonymous");
+    setSessionExpired(false);
+    handlers.current.forEach((handler) => handler(scope));
+    return scope;
+  }, []);
+
+  const onSignedOut = useCallback((handler: SignOutHandler) => {
+    handlers.current.add(handler);
+    return () => {
+      handlers.current.delete(handler);
+    };
+  }, []);
+
+  const value = useMemo<AuthContextValue>(
+    () => ({ status, user, sessionExpired, login, register, logout, refresh, onSignedOut }),
+    [status, user, sessionExpired, login, register, logout, refresh, onSignedOut],
+  );
+
+  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
+}
+
+export function useAuth(): AuthContextValue {
+  const value = useContext(AuthContext);
+  if (!value) throw new Error("useAuth phải nằm trong AuthProvider.");
+  return value;
+}
