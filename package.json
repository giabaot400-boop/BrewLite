{
  "name": "brewlite",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web", "apps/api"],
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "concurrently --kill-others-on-fail --names frontend,backend \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace apps/web",
    "dev:backend": "npm run start:dev --workspace apps/api",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm run db:generate --workspace apps/api",
    "db:validate": "npm run db:validate --workspace apps/api",
    "db:migrate": "npm run db:migrate --workspace apps/api --",
    "db:seed": "npm run db:seed --workspace apps/api"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
