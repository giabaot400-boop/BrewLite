generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id            String             @id
  name          String
  description   String
  price         Int
  imageUrl      String             @map("image_url")
  toppings      ProductTopping[]
  orderItems    OrderItem[]
  stock         Int                @default(0)
  reservedStock Int                @default(0) @map("reserved_stock")
  stockVersion  Int                @default(0) @map("stock_version")
  reservations  StockReservation[]

  @@map("products")
}

model Topping {
  id                String             @id
  name              String
  price             Int
  products          ProductTopping[]
  orderItemToppings OrderItemTopping[]

  @@map("toppings")
}

model ProductTopping {
  productId String  @map("product_id")
  toppingId String  @map("topping_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  topping   Topping @relation(fields: [toppingId], references: [id], onDelete: Cascade)

  @@id([productId, toppingId])
  @@map("product_toppings")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String           @map("password_hash")
  createdAt       DateTime         @default(now()) @map("created_at")
  sessions        AuthSession[]
  orders          Order[]
  orderRequests   OrderRequest[]
  loyaltyPoints   Int              @default(0) @map("loyalty_points")
  paymentAttempts PaymentAttempt[]
  loyaltyEntries  LoyaltyEntry[]

  @@map("users")
}

model AuthSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

enum OrderStatus {
  PENDING
  PAYMENT_FAILED
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderRequestState {
  SUCCEEDED
  REJECTED
}

model Order {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  status      OrderStatus @default(PENDING)
  total       Int
  createdAt   DateTime    @default(now()) @map("created_at")
  requestKey  String      @map("request_key")
  requestHash String      @map("request_hash")

  version               Int       @default(0)
  subtotal              Int
  discountTotal         Int       @default(0) @map("discount_total")
  checkoutPolicyVersion Int       @default(1) @map("checkout_policy_version")
  paymentDeadline       DateTime? @map("payment_deadline") @db.Timestamptz(3)
  paidAt                DateTime? @map("paid_at") @db.Timestamptz(3)
  cancelReason          String?   @map("cancel_reason")
  promotionId           String?   @map("promotion_id")
  promotionSnapshot     Json?     @map("promotion_snapshot")
  promotionEvaluatedAt  DateTime? @map("promotion_evaluated_at") @db.Timestamptz(3)
  loyaltyPolicySnapshot Json?     @map("loyalty_policy_snapshot")
  loyaltyPointsExpected Int?      @map("loyalty_points_expected")

  user    User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items   OrderItem[]
  request OrderRequest?

  promotion       Promotion?         @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  paymentAttempts PaymentAttempt[]
  reservations    StockReservation[]
  loyaltyEntry    LoyaltyEntry?

  @@unique([userId, requestKey])
  @@unique([id, userId])
  @@index([userId, createdAt, id])
  @@index([checkoutPolicyVersion, status, paymentDeadline, id])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid())
  orderId        String @map("order_id")
  productId      String @map("product_id")
  productName    String @map("product_name")
  size           String
  basePrice      Int    @map("base_price")
  sizeExtraPrice Int    @map("size_extra_price")
  unitPrice      Int    @map("unit_price")
  qty            Int
  lineTotal      Int    @map("line_total")

  order    Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product  Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  toppings OrderItemTopping[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderItemTopping {
  orderItemId String @map("order_item_id")
  toppingId   String @map("topping_id")
  name        String
  price       Int

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  topping   Topping   @relation(fields: [toppingId], references: [id], onDelete: Restrict)

  @@id([orderItemId, toppingId])
  @@index([toppingId])
  @@map("order_item_toppings")
}

model OrderRequest {
  id               String            @id @default(uuid())
  userId           String            @map("user_id")
  requestKey       String            @map("request_key")
  requestHash      String            @map("request_hash")
  canonicalVersion Int               @default(1) @map("canonical_version")
  state            OrderRequestState
  orderId          String?           @unique @map("order_id")
  httpStatus       Int               @map("http_status")
  responseJson     Json              @map("response_json")
  createdAt        DateTime          @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([userId, requestKey])
  @@map("order_requests")
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PaymentStatus {
  FAILED
  SUCCEEDED
}

enum StockReservationState {
  ACTIVE
  CONSUMED
  RELEASED
  RETURNED
}

model Promotion {
  id                String   @id @default(uuid())
  code              String   @unique
  active            Boolean  @default(true)
  startsAt          DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime @map("ends_at") @db.Timestamptz(3)
  minimumSubtotal   Int      @map("minimum_subtotal")
  type              String
  value             Int
  maxDiscountAmount Int?     @map("max_discount_amount")

  orders Order[]

  @@map("promotions")
}

model PaymentAttempt {
  id               String        @id @default(uuid())
  userId           String        @map("user_id")
  orderId          String        @map("order_id")
  requestKey       String        @map("request_key")
  requestHash      String        @map("request_hash")
  canonicalVersion Int           @default(1) @map("canonical_version")
  gatewayKey       String        @unique @map("gateway_key")
  method           PaymentMethod
  amount           Int
  status           PaymentStatus
  version          Int           @default(0)
  failureCode      String?       @map("failure_code")
  refundedAmount   Int           @default(0) @map("refunded_amount")
  refundedAt       DateTime?     @map("refunded_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  resolvedAt       DateTime      @map("resolved_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([userId, requestKey])
  @@index([orderId, createdAt, id])
  @@map("payment_attempts")
}

model StockReservation {
  id         String                @id @default(uuid())
  orderId    String                @map("order_id")
  productId  String                @map("product_id")
  qty        Int
  state      StockReservationState
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt DateTime?             @map("resolved_at") @db.Timestamptz(3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([orderId, state])
  @@map("stock_reservations")
}

model LoyaltyEntry {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  orderId    String    @unique @map("order_id")
  points     Int
  reversedAt DateTime? @map("reversed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([orderId, userId])
  @@index([userId])
  @@map("loyalty_entries")
}
