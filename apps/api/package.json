{
  "name": "@brewlite/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "prisma generate && nest build",
    "typecheck": "prisma generate && tsc --noEmit --project tsconfig.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "demo:advance": "node dist/orders/demo-advance.js",
    "pretest": "npm run db:generate",
    "test": "node --import tsx --test \"src/**/*.spec.ts\" \"src/**/*.test.ts\"",
    "test:workflow": "node --import tsx --test src/orders/workflow-postgres.integration.ts",
    "test:workflow-http": "node --import tsx prisma/check-workflow-http.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/bcrypt": "6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "bcryptjs": "^3.0.3",
    "prisma": "7.10.1",
    "tsx": "^4.20.5",
    "typescript": "6.0.3"
  }
}
